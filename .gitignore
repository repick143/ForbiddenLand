# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.pytype/
.ruff_cache/
.coverage
htmlcov/

# Packaging and build outputs
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local configuration and secrets
.env
.env.*
!.env.example

# Downloaded data and generated reports
data/raw/
data/processed/
data/cache/
reports/
*.sqlite3
*.db

# Large analytical data artifacts; keep payloads outside Git history.
*.parquet
*.duckdb
*.duckdb.wal
*.duckdb.tmp

# Editor and operating-system files
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Logs and temporary files
*.log
*.tmp
*.temp
