# Keep source and documentation line endings consistent across platforms.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# A-share exports may use legacy encodings; do not rewrite their bytes.
*.csv -text
*.xlsx binary
*.xls binary
*.parquet binary
*.db binary
*.sqlite3 binary
*.png binary
*.jpg binary
*.jpeg binary
