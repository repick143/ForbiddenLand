#!/usr/bin/env bash
# ecom-data: stable CLI entry point for the cache layer.
# Resolves the repository root even when invoked through a skill symlink.
set -euo pipefail

here="${BASH_SOURCE[0]}"
if command -v python3 >/dev/null 2>&1; then
  here="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$here")"
fi
root="$(cd "$(dirname "$here")/../../.." && pwd)"
py="$root/.venv/bin/python"
if [ ! -x "$py" ]; then
  echo "ecom-data: missing $py; run 'python scripts/bootstrap.py' first" >&2
  exit 1
fi
export PYTHONPATH="$root/skills/ecom-data/scripts${PYTHONPATH:+:$PYTHONPATH}"
exec "$py" -m ecom_data "$@"
