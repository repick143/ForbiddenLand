#!/usr/bin/env bash
# ecom-data launcher: references the installed library (src/ecom_data).
# Prefers the console script, falls back to `python -m ecom_data`.
set -euo pipefail

here="${BASH_SOURCE[0]}"
if command -v python3 >/dev/null 2>&1; then
  here="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$here")"
fi
root="$(cd "$(dirname "$here")/../../.." && pwd)"
py="$root/.venv/bin/python"
if [ ! -x "$py" ]; then
  echo "ecom-data: missing $py; run 'python scripts/bootstrap.py' first" >&2
  exit 1
fi
if [ -x "$root/.venv/bin/ecom-data" ]; then
  exec "$root/.venv/bin/ecom-data" "$@"
fi
exec "$py" -m ecom_data "$@"
