{
  "openapi": "3.1.0",
  "info": {
    "title": "ForbiddenLand API",
    "description": "Backend service for A-share research data and analysis views.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/market/securities": {
      "get": {
        "tags": [
          "market"
        ],
        "summary": "Securities",
        "operationId": "securities_api_v1_market_securities_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SecurityListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/market/assets": {
      "get": {
        "tags": [
          "market"
        ],
        "summary": "Assets",
        "operationId": "assets_api_v1_market_assets_get",
        "parameters": [
          {
            "name": "asset_type",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "stock",
                "index",
                "concept"
              ],
              "type": "string",
              "default": "stock",
              "title": "Asset Type"
            }
          },
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 64,
              "default": "",
              "title": "Query"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketAssetListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/market/bars": {
      "get": {
        "tags": [
          "market"
        ],
        "summary": "Market Bars",
        "operationId": "market_bars_api_v1_market_bars_get",
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "title": "Symbol"
            }
          },
          {
            "name": "start_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Start Date"
            }
          },
          {
            "name": "end_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "End Date"
            }
          },
          {
            "name": "asset_type",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "stock",
                "index",
                "concept"
              ],
              "type": "string",
              "default": "stock",
              "title": "Asset Type"
            }
          },
          {
            "name": "adjust",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "",
                "qfq",
                "hfq"
              ],
              "type": "string",
              "default": "",
              "title": "Adjust"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketBarsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "backend": {
            "type": "string",
            "title": "Backend"
          },
          "data_policy": {
            "type": "string",
            "title": "Data Policy"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "service",
          "version",
          "backend",
          "data_policy"
        ],
        "title": "HealthResponse"
      },
      "MarketAssetListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MarketAssetResponse"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "MarketAssetListResponse"
      },
      "MarketAssetResponse": {
        "properties": {
          "asset_type": {
            "type": "string",
            "enum": [
              "stock",
              "index",
              "concept"
            ],
            "title": "Asset Type"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "asset_type",
          "code",
          "name"
        ],
        "title": "MarketAssetResponse"
      },
      "MarketBarResponse": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "open": {
            "type": "number",
            "title": "Open"
          },
          "high": {
            "type": "number",
            "title": "High"
          },
          "low": {
            "type": "number",
            "title": "Low"
          },
          "close": {
            "type": "number",
            "title": "Close"
          },
          "volume": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Volume"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount"
          },
          "change": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Change"
          },
          "change_percent": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Change Percent"
          },
          "turnover_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Turnover Rate"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "symbol",
          "date",
          "open",
          "high",
          "low",
          "close",
          "volume"
        ],
        "title": "MarketBarResponse"
      },
      "MarketBarsResponse": {
        "properties": {
          "asset_type": {
            "type": "string",
            "enum": [
              "stock",
              "index",
              "concept"
            ],
            "title": "Asset Type"
          },
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "bars": {
            "items": {
              "$ref": "#/components/schemas/MarketBarResponse"
            },
            "type": "array",
            "title": "Bars"
          },
          "summary": {
            "$ref": "#/components/schemas/MarketSummaryResponse"
          },
          "provenance": {
            "$ref": "#/components/schemas/ProvenanceResponse"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "asset_type",
          "symbol",
          "bars",
          "summary",
          "provenance"
        ],
        "title": "MarketBarsResponse"
      },
      "MarketSummaryResponse": {
        "properties": {
          "bar_count": {
            "type": "integer",
            "title": "Bar Count"
          },
          "first_date": {
            "type": "string",
            "format": "date",
            "title": "First Date"
          },
          "latest_date": {
            "type": "string",
            "format": "date",
            "title": "Latest Date"
          },
          "latest_close": {
            "type": "number",
            "title": "Latest Close"
          },
          "period_change_percent": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Period Change Percent"
          },
          "max_close": {
            "type": "number",
            "title": "Max Close"
          },
          "min_close": {
            "type": "number",
            "title": "Min Close"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "bar_count",
          "first_date",
          "latest_date",
          "latest_close",
          "period_change_percent",
          "max_close",
          "min_close"
        ],
        "title": "MarketSummaryResponse"
      },
      "ProvenanceResponse": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source"
          },
          "backend": {
            "type": "string",
            "title": "Backend"
          },
          "storage": {
            "type": "string",
            "title": "Storage"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "title": "Start Date"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "title": "End Date"
          },
          "adjust": {
            "type": "string",
            "enum": [
              "",
              "qfq",
              "hfq"
            ],
            "title": "Adjust"
          },
          "retrieved_at_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Retrieved At Utc"
          },
          "local_snapshot_review_required": {
            "type": "boolean",
            "title": "Local Snapshot Review Required"
          },
          "cache_hit": {
            "type": "boolean",
            "title": "Cache Hit"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "backend",
          "storage",
          "start_date",
          "end_date",
          "adjust",
          "retrieved_at_utc",
          "local_snapshot_review_required",
          "cache_hit"
        ],
        "title": "ProvenanceResponse"
      },
      "SecurityListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SecurityResponse"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "SecurityListResponse"
      },
      "SecurityResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "name"
        ],
        "title": "SecurityResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
